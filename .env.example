# ───────────── shared (worker + web) ─────────────
# Railway Postgres. Use the public URL on Vercel, the internal one on Railway.
DATABASE_URL=postgresql://postgres:password@host:port/railway
# Solana mainnet RPC with a real rate limit (Helius, Triton, QuickNode...). Never the public endpoint.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Beta limits (all optional)
MAX_DEPOSIT_USD=1000
MIN_DEPOSIT_USD=25
MAX_AGENTS_PER_WALLET=5
AGENT_GAS_SOL=0.03
AGENT_MIN_GAS_SOL=0.006

# ───────────── web only (Vercel) ─────────────
# 32+ random characters: openssl rand -hex 32
AUTH_SECRET=
# ISO country codes blocked from spawning/depositing (Vercel geo header). Empty = no geofence.
BLOCKED_COUNTRIES=US,CA,GB,AU,CN,RU,IR,KP,SY,CU,BY

# ───────────── worker only (Railway) ─────────────
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_ORGANIZATION_ID=
# Provisioner: creates agent wallets and withdrawal policies (root user API key)
TURNKEY_PROVISIONER_API_PUBLIC_KEY=
TURNKEY_PROVISIONER_API_PRIVATE_KEY=
# Signer: NON-root user that signs every agent transaction, so policies are enforced
TURNKEY_SIGNER_API_PUBLIC_KEY=
TURNKEY_SIGNER_API_PRIVATE_KEY=
# Optional; looked up automatically if empty
TURNKEY_SIGNER_USER_ID=

# Jupiter. Without a key the free lite-api is used; with one, api.jup.ag.
JUPITER_API_KEY=
JUPITER_MAX_PRIORITY_LAMPORTS=300000

# Simulated paper-trading agents on the floor (clearly labelled SIM, hold no funds). 0 turns them off.
SIM_AGENTS=6
SIM_DEPOSIT_USD=1000

# Kill switches
TRADING_ENABLED=true
WITHDRAWALS_ENABLED=true

# Trading limits (optional)
MIN_TRADE_USD=5
MAX_ORDERS_PER_REBALANCE=4
MAX_PRICE_IMPACT_PCT=1.5
SLIPPAGE_BPS_STOCK=75
SLIPPAGE_BPS_PAIR=300

# stonk.fun pair discovery (optional)
DISCOVERY_MIN_MCAP_USD=100000
DISCOVERY_MIN_VOL24H_USD=5000
DISCOVERY_MAX_PAIRS=24
# how often to look for new stock-paired coins (seconds, min 30)
DISCOVERY_INTERVAL_SEC=60
# pump.fun custom pairs (found via DexScreener) and OTC desk coins that pay rewards in stocks
DISCOVERY_PUMP=true
DISCOVERY_MAX_PUMP=16
DISCOVERY_PUMP_MIN_MCAP_USD=30000
DISCOVERY_PUMP_MIN_VOL24H_USD=300
DISCOVERY_OTC=true
DISCOVERY_MAX_OTC=16
DISCOVERY_OTC_MIN_MCAP_USD=30000
DISCOVERY_OTC_MIN_VOL24H_USD=5000
